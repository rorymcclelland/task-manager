{
  // Only used by `npm run typecheck`. Node runs the .ts files directly by
  // stripping the types, so nothing here affects how the app runs.
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    // Node's type stripping can only remove syntax that has no runtime
    // meaning (so no enums, no namespaces, no constructor parameter
    // properties). This flag makes the compiler enforce that rule.
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    // The browser code is plain JavaScript with JSDoc comments; check it too.
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src", "test", "scripts"]
}
