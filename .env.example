# Copy this file to .env (in the same folder) and fill in what you want.
# .env is ignored by git — the Lunatask token is a password, keep it there.
# Every line is optional. Restart the app (npm start) after changing it.

# Lunatask → Settings → Access tokens → create one, paste it here.
LUNATASK_TOKEN=

# Folders to scan for "- [ ]" and "TODO:" lines in .md/.txt files.
# Separate several with a semicolon.
# LOCAL_FOLDERS=C:\Data\Sync\My files\Notes;C:\Data\Sync\My files\Projects

# Where dropped-in task files are picked up. Default: data\inbox
# INBOX_FOLDER=C:\Data\Sync\My files\Task inbox

# How often to sync, in minutes. 0 = only when you press "Sync now".
# SYNC_EVERY_MINUTES=15
